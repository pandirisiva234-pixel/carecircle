# CareCircle Environment Configuration Example
# Copy this file to .env.local for local development

# Session & Security
SESSION_SECRET="carecircle-secure-random-32-byte-secret-key-change-me"
CRON_SECRET="carecircle-cron-secret-change-me"

# Google Gemini API (@google/genai, model gemini-2.5-flash)
GEMINI_API_KEY="your-google-gemini-api-key"

# Google Cloud Firestore (via firebase-admin)
# Option A: Project ID with ADC (Application Default Credentials) on Google Cloud Run
FIREBASE_PROJECT_ID="your-gcp-project-id"

# Option B: Explicit Service Account Credentials (optional if using ADC)
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email Notifications (Nodemailer via Gmail SMTP)
GMAIL_USER="carecircle.alerts@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-gmail-app-password"

# Base URL for scheduled links and notifications
NEXT_PUBLIC_APP_URL="http://localhost:3000"
