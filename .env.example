# =========================================================
# CareCircle Environment Configuration Example
# Copy this file to .env.local for local development or set in Vercel Project Settings
# =========================================================

# Session & Security (Required in production)
SESSION_SECRET="carecircle-secure-random-32-byte-secret-key-change-me"
CRON_SECRET="generate-a-long-random-string"

# Timezone used for medication schedules and reminders (IANA name)
APP_TIMEZONE="Asia/Kolkata"

# Google Gemini API (@google/genai, model gemini-3.8-flash)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-google-gemini-api-key"
# Optional: override the Gemini model (falls back automatically if retired)
GEMINI_MODEL="gemini-3.8-flash"

# Google Cloud Firestore (via firebase-admin)
# Obtain service account credentials from:
# Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email Notifications (Nodemailer via Gmail SMTP)
# Generate 16-char app password: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER="carecircle.alerts@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-gmail-app-password"

# Base Application URL (Used by GitHub Actions and email links)
# e.g. https://carecircle.vercel.app or http://localhost:3000
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
